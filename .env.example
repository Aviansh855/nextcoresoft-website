# Search Console Performance API (optional — for npm run gsc:report).
# See docs/GSC-PERFORMANCE.md for one-time OAuth setup.
# GSC_OAUTH_CLIENT_ID=
# GSC_OAUTH_CLIENT_SECRET=
# GSC_REFRESH_TOKEN=
# GSC_SITE_URL=https://nextcoresoft.com/

# Google Search Console — HTML tag verification (optional).
# Copy the content value from GSC → Settings → Ownership verification → HTML tag.
# VITE_GSC_SITE_VERIFICATION=your_verification_token_here

# Optional override for the inquiry form endpoint.
# The site already submits to https://formspree.io/f/xzedydog.
# Set this only if you replace that form with a different one.
# VITE_FORM_ENDPOINT=https://formspree.io/f/yourFormId
VITE_FORM_ENDPOINT=

# Optional privacy-friendly analytics (Plausible).
# Set this to the domain you registered at https://plausible.io.
# When empty, no analytics script is ever loaded.
# Analytics only runs after a visitor explicitly opts in.
VITE_PLAUSIBLE_DOMAIN=
